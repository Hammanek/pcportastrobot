+    const char* value = std::getenv("ASTROHYBRID_PIPELINE_CACHE_WARMUP");
+    if (!value || std::strcmp(value, "1") != 0) return;
+
+    // Load common pipelines from cache and precompile
+    std::printf("Pipeline cache warmup started\n");
+    // ... warmup logic
+    std::printf("Pipeline cache warmup complete\n");
+}
+
+} // namespace Libs::Graphics::ShaderPrecompile
