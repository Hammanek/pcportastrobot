diff --git a/src/graphics/host_gpu/renderer/assetLoader.cpp b/src/graphics/host_gpu/renderer/assetLoader.cpp
new file mode 100644
index 0000000..xxxxxxx
--- /dev/null
+++ b/src/graphics/host_gpu/renderer/assetLoader.cpp
@@ -0,0 +1,120 @@
+#include "graphics/host_gpu/renderer/assetLoader.h"
+
+#include <queue>
+#include <thread>
+#include <mutex>
+#include <condition_variable>
+#include <atomic>
+#include <functional>
+
+namespace Libs::Graphics::AssetLoader {
+
+namespace {
+bool FastLoadEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("ASTROHYBRID_FAST_LOAD");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+struct LoadTask {
+    enum Priority { Low, Normal, High, Critical };
+    std::function<void()> work;
+    Priority priority = Normal;
+    uint64_t frame_deadline = 0;
+};
+
+struct LoaderState {
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::priority_queue<LoadTask, std::vector<LoadTask>,
+        std::function<bool(const LoadTask&, const LoadTask&)>> queue{
+            [](const LoadTask& a, const LoadTask& b) {
+                if (a.priority != b.priority) return a.priority < b.priority;
+                return a.frame_deadline > b.frame_deadline;
+            }};
+    std::thread worker;
+    std::atomic<bool> running{false};
+    std::atomic<uint64_t> current_frame{0};
+} g_state;
+} // namespace
+
+void Initialize() {
+    if (!FastLoadEnabled()) return;
+    g_state.running = true;
+    g_state.worker = std::thread([] {
+        while (g_state.running) {
+            LoadTask task;
+            {
+                std::unique_lock lock(g_state.mutex);
+                g_state.cv.wait(lock, [] { return !g_state.queue.empty() || !g_state.running; });
+                if (!g_state.running) break;
+                task = std::move(const_cast<LoadTask&>(g_state.queue.top()));
+                g_state.queue.pop();
+            }
+            task.work();
+        }
+    });
+}
+
+void Shutdown() {
+    g_state.running = false;
+    g_state.cv.notify_all();
+    if (g_state.worker.joinable()) g_state.worker.join();
+}
+
+void SetCurrentFrame(uint64_t frame) {
+    g_state.current_frame = frame;
+}
+
+void QueueLoad(std::function<void()> work, LoadTask::Priority priority, uint64_t deadline_frames) {
+    if (!FastLoadEnabled()) {
+        work(); // Synchronous fallback
+        return;
+    }
+    LoadTask task;
+    task.work = std::move(work);
+    task.priority = priority;
+    task.frame_deadline = g_state.current_frame + deadline_frames;
+    {
+        std::lock_guard lock(g_state.mutex);
+        g_state.queue.push(std::move(task));
+    }
+    g_state.cv.notify_one();
+}
+
+// Level transition: preload next level assets in background
+void PreloadLevel(uint32_t level_id) {
+    QueueLoad([level_id] {
+        // Load level geometry, textures, shaders
+        LoadLevelAssets(level_id);
+    }, LoadTask::High, 120); // 2 seconds at 60 FPS
+}
+
+void LoadLevelAssets(uint32_t level_id) {
+    // Placeholder for actual level asset loading
+}
+
+} // namespace Libs::Graphics::AssetLoader
