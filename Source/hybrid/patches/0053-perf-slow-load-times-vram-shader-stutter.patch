+
+namespace Libs::Graphics::ShaderPrecompile {
+
+namespace {
+struct PrecompileState {
+    std::thread worker;
+    std::atomic<bool> running{false};
+    std::atomic<bool> enabled{false};
+    std::vector<uint64_t> shader_queue;
+    std::atomic<size_t> queue_index{0};
+} g_state;
+
+bool PrecompileEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("ASTROHYBRID_SHADER_PRECOMPILE");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+} // namespace
+
+void Initialize() {
+    if (!PrecompileEnabled()) return;
+    g_state.enabled = true;
+    g_state.running = true;
+    g_state.worker = std::thread([] {
+        while (g_state.running) {
+            size_t idx = g_state.queue_index.fetch_add(1);
+            if (idx >= g_state.shader_queue.size()) {
+                std::this_thread::sleep_for(std::chrono::milliseconds(10));
+                continue;
+            }
+            uint64_t shader_hash = g_state.shader_queue[idx];
+            PrecompileShader(shader_hash);
+        }
+    });
+}
+
+void Shutdown() {
+    g_state.running = false;
+    if (g_state.worker.joinable()) g_state.worker.join();
+}
+
+void QueueShader(uint64_t shader_hash) {
+    if (!g_state.enabled) return;
+    g_state.shader_queue.push_back(shader_hash);
+}
+
+void PrecompileAll(const std::vector<uint64_t>& shaders) {
+    if (!g_state.enabled) return;
+    g_state.shader_queue = shaders;
+    g_state.queue_index = 0;
+}
+
+void PrecompileShader(uint64_t shader_hash) {
