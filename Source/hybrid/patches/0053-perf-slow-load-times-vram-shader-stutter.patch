@@ -0,0 +1,95 @@
+#include "graphics/host_gpu/renderer/textureStreaming.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <unordered_map>
+
+namespace Libs::Graphics::TextureStreaming {
+
+namespace {
+struct StreamingState {
+    uint64_t vram_budget_mb = 0;
+    uint64_t vram_used_mb = 0;
+    std::unordered_map<uint64_t, uint64_t> texture_sizes; // texture_id -> size_mb
+    std::unordered_map<uint64_t, uint64_t> texture_last_used; // texture_id -> frame
+    uint64_t current_frame = 0;
+} g_state;
+
+uint64_t GetVramBudgetMB() {
+    static const uint64_t budget = [] {
+        const char* value = std::getenv("ASTROHYBRID_VRAM_LIMIT_MB");
+        if (value) return static_cast<uint64_t>(std::strtoull(value, nullptr, 10));
+        return 0; // 0 = auto (use 90% of available VRAM)
+    }();
+    return budget;
+}
+
+bool StreamingEnabled() {
+    return GetVramBudgetMB() > 0;
+}
+} // namespace
+
+void Initialize(uint64_t vram_budget_mb) {
+    if (vram_budget_mb > 0) {
+        g_state.vram_budget_mb = vram_budget_mb;
+    } else if (GetVramBudgetMB() > 0) {
+        g_state.vram_budget_mb = GetVramBudgetMB();
+    }
+}
+
+void RegisterTexture(uint64_t texture_id, uint64_t size_mb) {
+    if (!StreamingEnabled()) return;
+    g_state.texture_sizes[texture_id] = size_mb;
+    g_state.vram_used_mb += size_mb;
+}
+
+void UnregisterTexture(uint64_t texture_id) {
+    if (!StreamingEnabled()) return;
+    auto it = g_state.texture_sizes.find(texture_id);
+    if (it != g_state.texture_sizes.end()) {
+        g_state.vram_used_mb -= it->second;
+        g_state.texture_sizes.erase(it);
+    }
+}
+
+void MarkTextureUsed(uint64_t texture_id) {
+    if (!StreamingEnabled()) return;
+    g_state.texture_last_used[texture_id] = g_state.current_frame;
+}
+
+void SetCurrentFrame(uint64_t frame) {
+    g_state.current_frame = frame;
+    EvictIfNeeded();
+}
+
+void EvictIfNeeded() {
+    if (!StreamingEnabled()) return;
+    if (g_state.vram_used_mb <= g_state.vram_budget_mb) return;
+
+    // Find least recently used textures to evict
+    struct Candidate { uint64_t id; uint64_t last_used; uint64_t size; };
+    std::vector<Candidate> candidates;
+    candidates.reserve(g_state.texture_sizes.size());
+
+    for (const auto& [id, size] : g_state.texture_sizes) {
+        uint64_t last_used = g_state.current_frame;
+        auto it = g_state.texture_last_used.find(id);
+        if (it != g_state.texture_last_used.end()) last_used = it->second;
+        candidates.push_back({id, last_used, size});
+    }
+
+    std::sort(candidates.begin(), candidates.end(),
+              [](const Candidate& a, const Candidate& b) { return a.last_used < b.last_used; });
+
+    for (const auto& c : candidates) {
+        if (g_state.vram_used_mb <= g_state.vram_budget_mb) break;
+        EvictTexture(c.id);
+    }
+}
+
+void EvictTexture(uint64_t texture_id) {
+    // Placeholder: actually evict texture from GPU memory
+    // This would involve Vulkan resource management
+    auto it = g_state.texture_sizes.find(texture_id);
+    if (it != g_state.texture_sizes.end()) {
+        g_state.vram_used_mb -= it->second;
+        g_state.texture_sizes.erase(it);
+    }
+}
+
+} // namespace Libs::Graphics::TextureStreaming
